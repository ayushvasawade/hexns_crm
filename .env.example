# =============================================================================
# HEXNS CRM - Production Environment Variables Reference
# =============================================================================

# =============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Netlify / Cloudflare Pages)
# =============================================================================
# Target Directory: /frontend (or set in Vercel project settings)

# Public URL of your deployed FastAPI backend with the /api/v1 suffix
NEXT_PUBLIC_API_URL=https://your-backend-api.up.railway.app/api/v1


# =============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Railway / Render / Fly.io / Docker / VPS)
# =============================================================================
# Target Directory: /backend (or set in hosting platform settings)

# Environment Mode & Debugging
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="HEXNS Mediaworks API"
VERSION=0.1.0

# CORS Allowed Origins (Comma-separated or JSON array, NO trailing slashes)
# Include your production frontend domain and any custom domains
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Optional Regex for Vercel preview deploys:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database Connection (Neon PostgreSQL)
# Accepts postgresql+asyncpg:// or standard postgresql:// (automatically normalized)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-example.neon.tech/neondb?ssl=require

# Synchronous Database URL (Optional: auto-derived from DATABASE_URL if omitted)
# SYNC_DATABASE_URL=postgresql+psycopg2://neondb_owner:YOUR_PASSWORD@ep-example.neon.tech/neondb?sslmode=require

# Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=True
DATABASE_ECHO=False

# JWT Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-to-a-very-long-and-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Port (assigned automatically by cloud hosts)
PORT=8000

