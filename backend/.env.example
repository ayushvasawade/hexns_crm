# Application Environment
APP_ENV=development
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="HEXNS Mediaworks API"
VERSION=0.1.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Neon PostgreSQL Database Connection
# Replace with your actual Neon connection string:
# Format: postgresql+asyncpg://<username>:<password>@<ep-xyz>.neon.tech/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hexns_crm
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hexns_crm

# Connection Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=True
DATABASE_ECHO=False
