# -----------------------------------------------------------------------------
# Backend Environment Variables (FastAPI)
# Set these in your Railway / Render / VPS / PaaS dashboard
# -----------------------------------------------------------------------------

# Application Environment ('production', 'staging', or 'development')
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="HEXNS Mediaworks API"
VERSION=0.1.0

# CORS Allowed Origins
# Comma-separated list or JSON array of frontend origins (no trailing slashes)
# Example: https://hexns-crm.vercel.app,http://localhost:3000
CORS_ORIGINS=https://your-frontend-domain.vercel.app

# Optional regex for dynamic frontend preview URLs (e.g. Vercel preview branches)
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Neon / PostgreSQL Database URL
# Accepts postgresql+asyncpg:// or postgresql:// or postgres:// (auto-normalized)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-example.neon.tech/neondb?ssl=require

# Synchronous Database URL (used by Alembic migrations)
# OPTIONAL: If omitted, automatically derived from DATABASE_URL with psycopg2 driver
SYNC_DATABASE_URL=postgresql+psycopg2://neondb_owner:YOUR_PASSWORD@ep-example.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=True
DATABASE_ECHO=False

# JWT Authentication
# IMPORTANT: In production, must be at least 32 characters long
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-to-a-very-long-and-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Port (usually auto-injected by Railway / Render / Heroku)
PORT=8000
