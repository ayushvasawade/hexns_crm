# -----------------------------------------------------------------------------
# Frontend Environment Variables (Next.js)
# Set these in your Vercel / Netlify / production hosting dashboard
# -----------------------------------------------------------------------------

# Production FastAPI backend URL including /api/v1 prefix
# Example: https://hexns-crm-api.up.railway.app/api/v1
# Local Dev: http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api/v1
